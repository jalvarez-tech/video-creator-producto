# Credenciales de integraciones — NO subir a git.
#
# `node herramientas/setup.mjs` crea tu `.env` a partir de este archivo si no
# existe. Si prefieres hacerlo a mano, copia este archivo como `.env`
# (cmd: `copy .env.example .env` · PowerShell y bash: `cp .env.example .env`)
# y rellena SOLO las claves que vayas a usar. Sin ninguna clave el sistema
# funciona en NIVEL 0 (plantillas, gráficos, demos, montaje, SFX, HyperFrames).
# Qué nivel tienes:  node herramientas/doctor.mjs
#
# El asistente NUNCA lee este archivo ni te pide las claves por chat: las
# escribes tú aquí. Cada script las lee de `.env` en el momento de usarlas.

# ── NIVEL 1 · gratis ─────────────────────────────────────────────────────────
# Pexels — B-ROLL DE ARCHIVO (fotos y vídeo reales, gratis y de uso comercial).
# Clave instantánea y gratuita en: https://www.pexels.com/api/
#   uv run manuales/edicion-video/scripts/bancos.py buscar --proyecto NNN --consulta "grieta en la pared"
# Hermano de XAI_API_KEY y no su sustituto: Grok GENERA un plano que no existe,
# esto TRAE uno que sí existe. En una pieza periodística, un lugar o un hecho
# real se trae — generarlo es fabricar prueba documental.
# Límite por defecto: 200 peticiones/hora, 20.000/mes (ampliable gratis).
PEXELS_API_KEY=

# ── NIVEL 2 · de pago ────────────────────────────────────────────────────────
# HeyGen — AVATAR talking-head a partir de un guion. API key en:
# https://app.heygen.com  →  Settings → API
HEYGEN_API_KEY=
# Avatar y voz por defecto de HeyGen (opcionales: si no, pásalos con --avatar/--voz).
# Lístalos con:  uv run manuales/edicion-video/scripts/heygen.py avatares
#                uv run manuales/edicion-video/scripts/heygen.py voces --idioma Spanish
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ElevenLabs — VOZ EN OFF (texto → audio). Clave en: https://elevenlabs.io
#   perfil (abajo a la izquierda) → API Keys → Create API Key
# Es el motor de voz del formato `video-noticias`: devuelve audio directo, sin
# renderizar un avatar que luego se tira. Se factura por CARACTERES.
ELEVENLABS_API_KEY=
# Voz por defecto (opcional). Lístalas con:
#   uv run manuales/edicion-video/scripts/elevenlabs.py voces
# (las marcadas «TUYA» son tus voces clonadas)
ELEVENLABS_VOICE_ID=

# xAI (Grok Imagine) — b-roll GENERADO e imágenes (lo que NO existe).
# Clave en: https://console.x.ai  — empieza por 'xai-'. NO es la de Groq (gsk_)
# ni la de RunAPI. Comprueba clave y créditos (un 403 = cuenta sin créditos):
#   uv run manuales/edicion-video/scripts/grok.py modelos
XAI_API_KEY=
